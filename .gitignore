# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Carpetas pesadas y entornos locales
node_modules/
.env*.local
.env

# Archivos subidos desde el panel. Son datos del cliente, no codigo.
# Ademas de no ensuciar el repositorio, estar ignorados los protege de un
# `git clean -fd`, que borra los archivos no rastreados.
/public/media/
